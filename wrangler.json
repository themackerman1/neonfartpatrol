{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neon-fart-patrol",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neon-fart-patrol",
      "database_id": "8d915674-a5df-47a0-9d2b-cca4e5c010e4",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "NeonRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "rooms-v1",
      "new_sqlite_classes": [
        "NeonRoom"
      ]
    }
  ]
}
